# Copy to contracts/.env and fill in. NEVER commit the real file.
#
# The deploy scripts read the key from here only — no key is ever pasted
# into a prompt, a config file, or a chat window.

# Private key of the deploying account (needs ETH on Robinhood Chain).
DEPLOYER_PRIVATE_KEY=0x

# Public origin of the running game server. tokenURI is built as
# <PUBLIC_ORIGIN>/api/cards/<cardId>/metadata, so this must be the URL
# that actually serves the game's API.
PUBLIC_ORIGIN=https://your-app.onrender.com

# Optional overrides — defaults are Robinhood Chain mainnet.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_CHAIN_ID=4663

# Only needed for `hardhat verify` against Blockscout.
BLOCKSCOUT_API_KEY=
